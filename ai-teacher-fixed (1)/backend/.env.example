# Primary LLM provider: Groq (fast, generous free tier, no cost commitment needed for a hackathon demo)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional overrides -- see https://console.groq.com/docs/models for current model IDs
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_EVAL_MODEL=llama-3.1-8b-instant   # optional: cheaper/faster model just for grading

DB_PATH=./ai_teacher.db
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
